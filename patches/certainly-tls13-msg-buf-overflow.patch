diff --git a/src/tls13_handshake.c b/src/tls13_handshake.c
index 6b500c8..3c93461 100644
--- a/src/tls13_handshake.c
+++ b/src/tls13_handshake.c
@@ -1159,6 +1159,16 @@ static tls13_hs_result tls13_read_encrypted_hs(
                 return kTLS13_Error;
             }
 
+            /* Never copy more than the destination can hold: a
+             * Certificate message can exceed 4 KB on real chains, and
+             * an unchecked copy here corrupted the context fields that
+             * follow msg_buf (observed with google.com's ~4.8 KB
+             * chain, which then failed CertificateVerify). */
+            if (total_hs > sizeof(hs->msg_buf)) {
+                hs->error = BR_ERR_TOO_LARGE;
+                return kTLS13_Error;
+            }
+
             /* Copy the handshake message to out_data */
             memcpy(out_data, hs->plain_buf + hs->plain_offset, total_hs);
             *out_len = total_hs;
diff --git a/src/tls13_handshake.h b/src/tls13_handshake.h
index 8af8dad..eb45fbf 100644
--- a/src/tls13_handshake.h
+++ b/src/tls13_handshake.h
@@ -107,8 +107,17 @@ typedef struct {
     unsigned char       client_hs_secret[64];
     unsigned char       server_hs_secret[64];
 
-    /* Buffer for non-certificate handshake messages (outgoing) */
-    unsigned char       msg_buf[4096];
+    /*
+     * Buffer for handshake messages (incoming and outgoing).
+     *
+     * Was 4096, which silently overflowed for Certificate messages
+     * larger than 4 KB: real-world chains run 3-5 KB (Google currently
+     * sends ~4.8 KB), and the memcpy in tls13_read_encrypted_hs() had
+     * no bounds check, corrupting the fields that follow this buffer.
+     * TLS records top out at 16 KB, so 16 KB holds any single-record
+     * handshake message.
+     */
+    unsigned char       msg_buf[16384];
     size_t              msg_len;
     size_t              msg_offset;
 
